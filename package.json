{
  "name": "pixels-roll20-chrome-extension",
  "version": "1.1.0",
  "description": "Connect Pixels dice to Roll20 via Bluetooth with advanced modifier support and seamless integration",
  "scripts": {
    "test": "jest",
    "test:fast": "jest --maxWorkers=1 --no-cache --no-watchman",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,html,css,md}\"",
    "build": "webpack --mode=development",
    "build:prod": "webpack --mode=production",
    "build:store": "npm run typecheck && npm run lint && npm run test && webpack --mode=production",
    "package:store": "scripts/package-for-store.sh",
    "package:store:force": "scripts/package-for-store.sh --skip-tests",
    "zip:store": "cd dist && zip -r ../pixels-roll20-extension-store.zip . && cd .. && echo 'Extension packaged as pixels-roll20-extension-store.zip'",
    "watch": "webpack --mode=development --watch",
    "prepare": "husky",
    "precommit": "npm run format:check && npm run lint && npm test"
  },
  "keywords": [
    "chrome-extension",
    "roll20",
    "pixels-dice",
    "bluetooth",
    "dnd"
  ],
  "author": "Enhanced by community contributors",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.27.2",
    "@babel/runtime": "^7.27.6",
    "@eslint/js": "^9.30.0",
    "@types/chrome": "^0.2.5",
    "@types/jest": "^29.5.11",
    "@types/ramda": "^0.32.0",
    "@types/web-bluetooth": "^0.0.21",
    "babel-jest": "^30.0.2",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.44.0",
    "css-loader": "^7.1.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "~5.8",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/jest/**/*.test.js",
      "<rootDir>/tests/jest/**/*.test.ts",
      "!<rootDir>/tests/jest/experimental/**/*.test.js",
      "!<rootDir>/tests/jest/experimental/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/content/**/*.ts",
      "!src/content/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/jest/experimental/"
    ],
    "maxWorkers": 1,
    "testTimeout": 5000,
    "detectOpenHandles": false,
    "forceExit": true,
    "cache": false,
    "watchman": false,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ],
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(ramda)/)"
    ],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@content/(.*)$": "<rootDir>/src/content/$1",
      "^@core/(.*)$": "<rootDir>/src/core/$1"
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.js": [
      "prettier --write"
    ],
    "*.{json,html,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@3d-dice/dice-roller-parser": "^0.2.6",
    "eslint": "^9.30.0",
    "ramda": "^0.31.3"
  }
}
